####################################
# Pollaris
####################################

APP_ENV="prod"

APP_SECRET="CHANGE_ME"

APP_BASE_URL="https://pollaris.yourdomain.com"

APP_NAME="Quando"

APP_TIMEZONE="Europe/Berlin"


####################################
# PostgreSQL
####################################

POSTGRES_DB="pollaris"

POSTGRES_USER="pollaris"

POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL="postgresql://pollaris:CHANGE_ME@database:5432/pollaris?serverVersion=15&charset=utf8"


####################################
# Mail
####################################

MAILER_DSN="smtps://user@domain.tld:YOURPASSWORD@relayserver:465"

MAILER_FROM="user@domain.tld"

MAILER_FROM_NAME="Pollaris"


####################################
# Symfony Messenger
####################################

MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=0"
